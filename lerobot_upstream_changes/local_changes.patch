+            delta_roll = (vr_goal.wrist_roll_deg - self.prev_wrist_roll) * angle_scale
+            delta_roll = max(-angle_limit, min(angle_limit, delta_roll))
+
+            if delta_roll < 1 and delta_roll > -1:
+                delta_roll = 0.0
